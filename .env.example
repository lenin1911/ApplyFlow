# Production Environment Variables Example for FastAPI Backend
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/applyflow
SECURITY_KEY=replace-with-a-secure-random-32-byte-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
